{
  "name": "@gemini-agy/dsh-web-frontend",
  "description": "Web application entry: vite build over the @gemini-agy/dsh-client-web shell library; dist/ served by apps/cli's dsh web",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/agy-gemini-harness.git",
    "directory": "apps/web"
  },
  "type": "module",
  "exports": {
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/preview.html",
    "!dist/preview",
    "src"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "watch": "vite build --watch --no-emptyOutDir",
    "build:preview": "pnpm --filter @gemini-agy/dsh-experimental-webworker-runtime exec tsdown && pnpm --filter @gemini-agy/dsh-experimental-webworker-packer exec tsdown && vite build && dsh-pack-vfs-image --out dist/preview/vfs-image.tar.gz",
    "serve:preview": "http-server dist -a 0.0.0.0 -p 4173 -c-1",
    "render:app-icons": "tsx scripts/render-app-icons.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@gemini-agy/dsh-brand": "workspace:*",
    "zod": "4.6.6",
    "@tanstack/react-virtual": "3.14.10",
    "@gemini-agy/cordis": "workspace:~",
    "@gemini-agy/cordis-plugin-group": "workspace:~",
    "@gemini-agy/dsh-client-modules": "workspace:*",
    "@gemini-agy/dsh-client-store": "workspace:*",
    "@gemini-agy/dsh-llm-mock-server": "workspace:*",
    "@gemini-agy/dsh-client-test-runtime": "workspace:*",
    "@gemini-agy/dsh-client-ui-deliverables": "workspace:*",
    "@gemini-agy/dsh-client-ui-dockkit": "workspace:*",
    "@gemini-agy/dsh-client-ui-primitives": "workspace:*",
    "@gemini-agy/dsh-client-ui-slots": "workspace:*",
    "@gemini-agy/dsh-client-web": "workspace:*",
    "@gemini-agy/dsh-cmdline": "workspace:*",
    "@gemini-agy/dsh-pwsh-local": "workspace:*",
    "@gemini-agy/dsh-agent-team": "workspace:*",
    "@gemini-agy/dsh-experimental-webworker-packer": "workspace:*",
    "@gemini-agy/dsh-experimental-webworker-runtime": "workspace:*",
    "@gemini-agy/dsh-remote-mock": "workspace:*",
    "@gemini-agy/dsh-session-projection-cache": "workspace:*",
    "@gemini-agy/dsh-tool-testkit": "workspace:*",
    "@gemini-agy/dsh-util-values": "workspace:*",
    "@types/node": "^22.20.1",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "http-server": "^14.1.1",
    "fflate": "^0.8.2",
    "playwright": "^1.49.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sharp": "0.35.5",
    "typescript": "^6.0.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.11",
    "ws": "8.21.3",
    "@gemini-agy/dsh-client-ui-theme": "workspace:*",
    "@gemini-agy/dsh-launch-environment": "workspace:*",
    "@gemini-agy/dsh-workspace-changes": "workspace:*",
    "@gemini-agy/dsh-subprocess-local": "workspace:*",
    "@gemini-agy/dsh-experimental-auto-review": "workspace:*",
    "@gemini-agy/dsh-experimental-speech-to-text": "workspace:*",
    "@gemini-agy/dsh-experimental-voice-input-bundle": "workspace:*",
    "@gemini-agy/dsh-experimental-cot-translation-bundle": "workspace:*",
    "@gemini-agy/dsh-experimental-worktree": "workspace:*",
    "@gemini-agy/dsh-experimental-plugin-market-bundle": "workspace:*",
    "@gemini-agy/dsh-experimental-forge-bundle": "workspace:*"
  },
  "dependencies": {
    "@gemini-agy/dsh-message-quotes": "workspace:*"
  }
}
