{
  "name": "@gemini-agy/dsh-tool-workspace-dependencies",
  "description": "The load_workspace_dependencies tool: absolute paths into a bundled Python, Node.js, and pnpm payload",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/agy-gemini-harness.git",
    "directory": "packages/skill/tool-workspace-dependencies"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@gemini-agy/dsh-error": "workspace:*",
    "@gemini-agy/dsh-tools": "workspace:*",
    "@gemini-agy/cordis": "workspace:~"
  },
  "devDependencies": {
    "@gemini-agy/dsh-brand": "workspace:*",
    "@gemini-agy/dsh-tool-executor-native": "workspace:*",
    "@gemini-agy/dsh-tool-testkit": "workspace:*",
    "@gemini-agy/dsh-tools": "workspace:*",
    "@gemini-agy/cordis": "workspace:~",
    "@gemini-agy/cordis-plugin-loader": "workspace:~",
    "@gemini-agy/cordis-plugin-include": "workspace:~",
    "@gemini-agy/dsh-agent": "workspace:*",
    "@gemini-agy/dsh-llm": "workspace:*",
    "@gemini-agy/dsh-error": "workspace:*",
    "@gemini-agy/dsh-system-prompt": "workspace:*"
  },
  "dependencies": {
    "@gemini-agy/schemastery": "workspace:~"
  }
}
