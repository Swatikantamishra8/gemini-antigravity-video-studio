{
  "name": "@gemini-agy/dsh-token-meter",
  "description": "Replay-aware token measurement service (ctx.tokenMeter) for the Gemini Antigravity Harness",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/agy-gemini-harness.git",
    "directory": "packages/llm/token-meter"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./estimate": {
      "types": "./lib/types/estimate.d.ts",
      "default": "./lib/types/estimate.js"
    },
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@gemini-agy/cordis": "workspace:~",
    "@gemini-agy/dsh-compaction": "workspace:*",
    "@gemini-agy/dsh-llm": "workspace:*",
    "@gemini-agy/dsh-llm-retry": "workspace:*",
    "@gemini-agy/dsh-session": "workspace:*",
    "@gemini-agy/dsh-session-projection": "workspace:*",
    "@gemini-agy/dsh-compaction-image-offload": "workspace:*"
  },
  "dependencies": {
    "@gemini-agy/dsh-util-values": "workspace:*",
    "@gemini-agy/schemastery": "workspace:~",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@gemini-agy/cordis": "workspace:~",
    "@gemini-agy/dsh-brand": "workspace:*",
    "@gemini-agy/dsh-compaction": "workspace:*",
    "@gemini-agy/dsh-llm": "workspace:*",
    "@gemini-agy/dsh-llm-retry": "workspace:*",
    "@gemini-agy/dsh-session": "workspace:*",
    "@gemini-agy/dsh-session-projection": "workspace:*",
    "@gemini-agy/dsh-compaction-image-offload": "workspace:*"
  }
}
