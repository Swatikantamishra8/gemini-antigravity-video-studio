{
  "name": "@gemini-agy/dsh-agent-preset-registry",
  "description": "Declarative Agent preset registry and profile-backed editing",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/agy-gemini-harness.git",
    "directory": "packages/preset/agent-preset-registry"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./display": {
      "types": "./lib/types/display.d.ts",
      "default": "./lib/types/display.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/typert.remote-client.d.ts.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@gemini-agy/cordis-plugin-include": "workspace:~",
    "@gemini-agy/cordis-plugin-loader": "workspace:~",
    "@gemini-agy/dsh-agent": "workspace:*",
    "@gemini-agy/dsh-scope": "workspace:*",
    "@gemini-agy/dsh-session": "workspace:*",
    "@gemini-agy/dsh-session-projection": "workspace:*",
    "@gemini-agy/dsh-settings": "workspace:*",
    "@gemini-agy/dsh-system-prompt": "workspace:*",
    "@gemini-agy/dsh-tools": "workspace:*",
    "@gemini-agy/dsh-typert-protocol": "workspace:*",
    "@gemini-agy/cordis": "workspace:~"
  },
  "dependencies": {
    "@gemini-agy/dsh-app-boot": "workspace:*",
    "@gemini-agy/schemastery": "workspace:~",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@gemini-agy/dsh-brand": "workspace:*",
    "@gemini-agy/cordis-plugin-group": "workspace:~",
    "@gemini-agy/cordis-plugin-include": "workspace:~",
    "@gemini-agy/cordis-plugin-loader": "workspace:~",
    "@gemini-agy/dsh-agent": "workspace:*",
    "@gemini-agy/dsh-agent-loop": "workspace:*",
    "@gemini-agy/dsh-atomic-write": "workspace:*",
    "@gemini-agy/dsh-llm": "workspace:*",
    "@gemini-agy/dsh-scope": "workspace:*",
    "@gemini-agy/dsh-session": "workspace:*",
    "@gemini-agy/dsh-session-projection": "workspace:*",
    "@gemini-agy/dsh-settings": "workspace:*",
    "@gemini-agy/dsh-system-prompt": "workspace:*",
    "@gemini-agy/dsh-tool-executor-native": "workspace:*",
    "@gemini-agy/dsh-tool-executor-ptc": "workspace:*",
    "@gemini-agy/dsh-tool-testkit": "workspace:*",
    "@gemini-agy/dsh-tools": "workspace:*",
    "@gemini-agy/dsh-typert-protocol": "workspace:*",
    "@gemini-agy/cordis": "workspace:~",
    "@gemini-agy/dsh-fs-local": "workspace:*",
    "@gemini-agy/dsh-hmr": "workspace:*",
    "@gemini-agy/dsh-ptc-runtime": "workspace:*",
    "@gemini-agy/dsh-sandbox": "workspace:*",
    "@gemini-agy/dsh-sandbox-policy": "workspace:*",
    "@gemini-agy/dsh-user-approval": "workspace:*",
    "@gemini-agy/dsh-agent-preset": "workspace:*",
    "@gemini-agy/dsh-working-directory": "workspace:*"
  }
}
