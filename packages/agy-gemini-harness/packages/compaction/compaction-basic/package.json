    "directory": "packages/compaction/compaction-basic"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@gemini-agy/cordis": "workspace:~",
    "@gemini-agy/dsh-agent": "workspace:*",
    "@gemini-agy/dsh-commands": "workspace:*",
    "@gemini-agy/dsh-compaction": "workspace:*",
    "@gemini-agy/dsh-compaction-tool-result-pruner": "workspace:*",
    "@gemini-agy/dsh-llm": "workspace:*",
    "@gemini-agy/dsh-session": "workspace:*",
    "@gemini-agy/dsh-session-projection": "workspace:*",
    "@gemini-agy/dsh-token-meter": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@gemini-agy/dsh-compaction-tool-result-pruner": {
      "optional": true
    }
  },
  "dependencies": {
    "@gemini-agy/dsh-brand": "workspace:*",
    "@gemini-agy/dsh-util-values": "workspace:*",
    "@gemini-agy/schemastery": "workspace:~",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@gemini-agy/cordis": "workspace:~",
    "@gemini-agy/cordis-plugin-include": "workspace:~",
    "@gemini-agy/cordis-plugin-loader": "workspace:~",
    "@gemini-agy/dsh-agent": "workspace:*",
    "@gemini-agy/dsh-agent-loop": "workspace:*",
    "@gemini-agy/dsh-agent-loop-testkit": "workspace:*",
    "@gemini-agy/dsh-commands": "workspace:*",
    "@gemini-agy/dsh-compaction": "workspace:*",
    "@gemini-agy/dsh-compaction-tool-result-pruner": "workspace:*",
    "@gemini-agy/dsh-llm": "workspace:*",
    "@gemini-agy/dsh-llm-retry": "workspace:*",
    "@gemini-agy/dsh-session": "workspace:*",
    "@gemini-agy/dsh-session-projection": "workspace:*",
    "@gemini-agy/dsh-token-meter": "workspace:*",
    "@gemini-agy/dsh-tool-testkit": "workspace:*",
    "@gemini-agy/dsh-tools": "workspace:*",
    "@gemini-agy/dsh-compaction-image-offload": "workspace:*"
  }
