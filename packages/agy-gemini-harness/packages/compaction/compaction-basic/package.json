{
  "name": "@gemini-agy/dsh-compaction-basic",
  "description": "Token-meter-driven compaction policy and LLM summarization backend for the Gemini Antigravity Harness",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
