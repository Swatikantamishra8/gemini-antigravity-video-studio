{
  "name": "@gemini-agy/dsh-attachment",
  "description": "Durable immutable attachment storage seam for the Gemini Antigravity Harness",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/agy-gemini-harness.git",
    "directory": "packages/attachment/attachment"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./types": { "types": "./lib/types/types.d.ts", "default": "./lib/types/types.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/types/**/*.js", "lib/types/**/*.d.ts", "lib/types/**/*.d.ts.map", "lib/**/*.js.map", "src"],
  "license": "MIT",
  "peerDependencies": {
    "@gemini-agy/dsh-error": "workspace:*",
    "@gemini-agy/cordis": "workspace:~"
  },
  "devDependencies": {
    "@gemini-agy/dsh-brand": "workspace:*",
    "@gemini-agy/dsh-error": "workspace:*",
    "@gemini-agy/cordis": "workspace:~"
  }
}
