{
  "name": "@gemini-agy/dsh-lsp-stdio",
  "description": "Generic stdio language-server provider for the Gemini Antigravity Harness LSP capability seam (ctx.lsp) — spawns configured servers, translates JSON-RPC, and serves transient-open goToDefinition/findReferences/goToImplementation/hover queries in the host filesystem namespace",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/agy-gemini-harness.git",
    "directory": "packages/lsp/lsp-stdio"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@gemini-agy/cordis": "workspace:~",
    "@gemini-agy/dsh-error": "workspace:*",
    "@gemini-agy/dsh-fs": "workspace:*",
    "@gemini-agy/dsh-llm": "workspace:*",
    "@gemini-agy/dsh-lsp": "workspace:*",
    "@gemini-agy/dsh-subprocess": "workspace:*",
    "@gemini-agy/dsh-timeout": "workspace:*"
  },
  "dependencies": {
    "@gemini-agy/dsh-brand": "workspace:*",
    "@gemini-agy/dsh-util-values": "workspace:*",
    "@gemini-agy/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@gemini-agy/cordis": "workspace:~",
    "@gemini-agy/dsh-error": "workspace:*",
    "@gemini-agy/dsh-fs": "workspace:*",
    "@gemini-agy/dsh-fs-local": "workspace:*",
    "@gemini-agy/dsh-llm": "workspace:*",
    "@gemini-agy/dsh-lsp": "workspace:*",
    "@gemini-agy/dsh-subprocess": "workspace:*",
    "@gemini-agy/dsh-subprocess-local": "workspace:*",
    "@gemini-agy/dsh-timeout": "workspace:*",
    "typescript": "^6.0.3",
    "typescript-language-server": "^5.0.0"
  }
}
