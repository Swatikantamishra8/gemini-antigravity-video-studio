{
  "name": "@gemini-agy/dsh-tool-lsp",
  "description": "Model-facing lsp tool over the Gemini Antigravity Harness LSP capability seam (ctx.lsp) \u2014 one read-only tool with goToDefinition/findReferences/goToImplementation/hover operations, one-based UTF-16 cursor coordinates, bounded location rendering, and hover normalization",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/agy-gemini-harness.git",
    "directory": "packages/lsp/tool-lsp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@gemini-agy/cordis": "workspace:~",
    "@gemini-agy/dsh-llm": "workspace:*",
    "@gemini-agy/dsh-lsp": "workspace:*",
    "@gemini-agy/dsh-system-prompt": "workspace:*",
    "@gemini-agy/dsh-timeout": "workspace:*",
    "@gemini-agy/dsh-tools": "workspace:*",
    "@gemini-agy/dsh-working-directory": "workspace:*"
  },
  "dependencies": {
    "@gemini-agy/dsh-util-values": "workspace:*",
    "@gemini-agy/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@gemini-agy/cordis": "workspace:~",
    "@gemini-agy/dsh-agent": "workspace:*",
    "@gemini-agy/dsh-brand": "workspace:*",
    "@gemini-agy/dsh-fs-local": "workspace:*",
    "@gemini-agy/dsh-llm": "workspace:*",
    "@gemini-agy/dsh-lsp": "workspace:*",
    "@gemini-agy/dsh-lsp-stdio": "workspace:*",
    "@gemini-agy/dsh-session": "workspace:*",
    "@gemini-agy/dsh-subprocess-local": "workspace:*",
    "@gemini-agy/dsh-system-prompt": "workspace:*",
    "@gemini-agy/dsh-timeout": "workspace:*",
    "@gemini-agy/dsh-tool-call-timeout-policy": "workspace:*",
    "@gemini-agy/dsh-tool-executor-native": "workspace:*",
    "@gemini-agy/dsh-tool-testkit": "workspace:*",
    "@gemini-agy/dsh-tools": "workspace:*",
    "@gemini-agy/dsh-working-directory": "workspace:*",
    "@gemini-agy/dsh-agent-loop-testkit": "workspace:*"
  }
}
