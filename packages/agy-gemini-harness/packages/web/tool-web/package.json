{
  "name": "@gemini-agy/dsh-tool-web",
  "description": "Model-facing web tools (web_search, web_fetch) over the Gemini Antigravity Harness web capability seam (ctx.web)",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/agy-gemini-harness.git",
    "directory": "packages/web/tool-web"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@gemini-agy/cordis": "workspace:~",
    "@gemini-agy/dsh-llm": "workspace:*",
    "@gemini-agy/dsh-system-prompt": "workspace:*",
    "@gemini-agy/dsh-tools": "workspace:*",
    "@gemini-agy/dsh-web": "workspace:*"
  },
  "dependencies": {
    "@gemini-agy/dsh-output-retention": "workspace:*",
    "@gemini-agy/dsh-util-values": "workspace:*",
    "@gemini-agy/schemastery": "workspace:~",
    "@joplin/turndown-plugin-gfm": "^1.0.67",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@gemini-agy/dsh-brand": "workspace:*",
    "@gemini-agy/cordis": "workspace:~",
    "@gemini-agy/dsh-agent": "workspace:*",
    "@gemini-agy/dsh-llm": "workspace:*",
    "@gemini-agy/dsh-session": "workspace:*",
    "@gemini-agy/dsh-spill-local": "workspace:*",
    "@gemini-agy/dsh-spill-policy": "workspace:*",
    "@gemini-agy/dsh-system-prompt": "workspace:*",
    "@gemini-agy/dsh-tool-call-timeout-policy": "workspace:*",
    "@gemini-agy/dsh-tool-executor-native": "workspace:*",
    "@gemini-agy/dsh-tool-testkit": "workspace:*",
    "@gemini-agy/dsh-tools": "workspace:*",
    "@gemini-agy/dsh-web": "workspace:*",
    "@gemini-agy/dsh-web-deepseek-api": "workspace:*",
    "@gemini-agy/dsh-web-fetch-http": "workspace:*",
    "@types/turndown": "^5.0.6",
    "@gemini-agy/dsh-scope": "workspace:*",
    "@gemini-agy/dsh-token-meter": "workspace:*",
    "@gemini-agy/dsh-launch-environment": "workspace:*"
  }
}
