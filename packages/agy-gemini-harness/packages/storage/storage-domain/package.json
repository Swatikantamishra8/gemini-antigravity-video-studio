{
  "name": "@gemini-agy/dsh-storage-domain",
  "description": "Domain data form (ctx.storage.domain): schema-validated, event-emitting KV domains over storage backends for the Gemini Antigravity Harness",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/agy-gemini-harness.git",
    "directory": "packages/storage/storage-domain"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@gemini-agy/dsh-storage": "workspace:*",
    "@gemini-agy/cordis": "workspace:~"
  },
  "dependencies": {
    "@gemini-agy/schemastery": "workspace:~",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@gemini-agy/dsh-storage": "workspace:*",
    "@gemini-agy/cordis": "workspace:~"
  }
}
