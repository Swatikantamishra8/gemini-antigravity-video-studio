{
  "name": "@gemini-agy/dsh-hooks-claude-code",
  "description": "Bridge plugin: run a Gemini 3.8 Flash High Code hooks.json / settings hook config on the Gemini Antigravity Harness interception seams",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/agy-gemini-harness.git",
    "directory": "packages/experimental/hooks-claude-code"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "@gemini-agy/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@gemini-agy/dsh-agent": "workspace:*",
    "@gemini-agy/dsh-hook-protocol": "workspace:*",
    "@gemini-agy/dsh-llm": "workspace:*",
    "@gemini-agy/dsh-session": "workspace:*",
    "@gemini-agy/dsh-subagent": "workspace:*",
    "@gemini-agy/dsh-tools": "workspace:*",
    "@gemini-agy/cordis": "workspace:~",
    "@gemini-agy/dsh-working-directory": "workspace:*"
  },
  "devDependencies": {
    "@gemini-agy/dsh-brand": "workspace:*",
    "@gemini-agy/dsh-agent": "workspace:*",
    "@gemini-agy/dsh-agent-loop": "workspace:*",
    "@gemini-agy/dsh-agent-loop-testkit": "workspace:*",
    "@gemini-agy/dsh-shell": "workspace:*",
    "@gemini-agy/dsh-bash-local": "workspace:*",
    "@gemini-agy/dsh-subprocess-local": "workspace:*",
    "@gemini-agy/dsh-hook-protocol": "workspace:*",
    "@gemini-agy/dsh-llm": "workspace:*",
    "@gemini-agy/dsh-session": "workspace:*",
    "@gemini-agy/dsh-session-persistence-jsonl": "workspace:*",
    "@gemini-agy/dsh-subagent": "workspace:*",
    "@gemini-agy/dsh-tool-testkit": "workspace:*",
    "@gemini-agy/dsh-tools": "workspace:*",
    "@gemini-agy/cordis": "workspace:~",
    "@gemini-agy/dsh-session-projection": "workspace:*",
    "@gemini-agy/dsh-working-directory": "workspace:*",
    "@gemini-agy/dsh-fs-local": "workspace:*"
  }
}
