{
  "name": "@gemini-agy/dsh-hook-protocol",
  "description": "Shared Gemini 3.8 Flash High Code / Codex hook wire protocol: matcher engine, stdin/exit-code/stdout codec, multi-hook merge, and hook/* session events",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/agy-gemini-harness.git",
    "directory": "packages/experimental/hook-protocol"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@gemini-agy/dsh-shell": "workspace:*",
    "@gemini-agy/dsh-session": "workspace:*",
    "@gemini-agy/cordis": "workspace:~"
  },
  "devDependencies": {
    "@gemini-agy/dsh-brand": "workspace:*",
    "@gemini-agy/dsh-shell": "workspace:*",
    "@gemini-agy/dsh-session": "workspace:*",
    "@gemini-agy/cordis": "workspace:~"
  }
}
