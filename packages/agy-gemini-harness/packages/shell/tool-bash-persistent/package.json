    "@gemini-agy/dsh-timeout": "workspace:*",
    "@gemini-agy/dsh-tools": "workspace:*",
    "@gemini-agy/cordis": "workspace:~",
    "@gemini-agy/dsh-working-directory": "workspace:*"
  },
  "dependencies": {
    "@gemini-agy/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@gemini-agy/dsh-brand": "workspace:*",
    "@gemini-agy/cordis-plugin-include": "workspace:~",
    "@gemini-agy/cordis-plugin-loader": "workspace:~",
    "@gemini-agy/dsh-agent": "workspace:*",
    "@gemini-agy/dsh-agent-loop-testkit": "workspace:*",
    "@gemini-agy/dsh-llm": "workspace:*",
    "@gemini-agy/dsh-output-retention": "workspace:*",
    "@gemini-agy/dsh-terminal": "workspace:*",
    "@gemini-agy/dsh-terminal-bash": "workspace:*",
    "@gemini-agy/dsh-sandbox": "workspace:*",
    "@gemini-agy/dsh-sandbox-policy": "workspace:*",
    "@gemini-agy/dsh-session": "workspace:*",
    "@gemini-agy/dsh-subprocess-local": "workspace:*",
    "@gemini-agy/dsh-system-prompt": "workspace:*",
    "@gemini-agy/dsh-timeout": "workspace:*",
    "@gemini-agy/dsh-tool-executor-native": "workspace:*",
    "@gemini-agy/dsh-tool-testkit": "workspace:*",
    "@gemini-agy/dsh-tools": "workspace:*",
    "@gemini-agy/cordis": "workspace:~",
    "@gemini-agy/dsh-session-projection": "workspace:*",
    "@gemini-agy/dsh-working-directory": "workspace:*"
  }
