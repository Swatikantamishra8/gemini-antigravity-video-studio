{
  "name": "@gemini-agy/dsh-shell",
  "description": "Abstract bash executor seam (ctx.shell) for the Gemini Antigravity Harness",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/agy-gemini-harness.git",
    "directory": "packages/shell/shell"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@gemini-agy/dsh-subprocess": "workspace:*",
    "@gemini-agy/dsh-sandbox": "workspace:*",
    "@gemini-agy/cordis": "workspace:~"
  },
  "devDependencies": {
    "@gemini-agy/dsh-subprocess": "workspace:*",
    "@gemini-agy/dsh-sandbox": "workspace:*",
    "@gemini-agy/cordis": "workspace:~"
  }
}
