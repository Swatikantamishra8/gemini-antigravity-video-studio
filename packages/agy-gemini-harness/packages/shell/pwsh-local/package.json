{
  "name": "@gemini-agy/dsh-pwsh-local",
  "description": "Local PowerShell implementation of the Gemini Antigravity Harness bash executor seam",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/agy-gemini-harness.git",
    "directory": "packages/shell/pwsh-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@gemini-agy/dsh-shell": "workspace:*",
    "@gemini-agy/dsh-subprocess": "workspace:*",
    "@gemini-agy/dsh-timeout": "workspace:*",
    "@gemini-agy/cordis": "workspace:~"
  },
  "dependencies": {
    "@gemini-agy/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@gemini-agy/dsh-shell": "workspace:*",
    "@gemini-agy/dsh-subprocess": "workspace:*",
    "@gemini-agy/dsh-subprocess-local": "workspace:*",
    "@gemini-agy/dsh-timeout": "workspace:*",
    "@gemini-agy/cordis": "workspace:~"
  }
}
